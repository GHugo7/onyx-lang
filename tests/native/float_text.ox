// Reading and writing floats exactly; powers.

fn main() {
    print(parse_float("1.5") or -1.0, parse_float(" -0.1 ") or -1.0, parse_float("6.02e23") or -1.0, parse_float(".5") or -1.0, parse_float("5.") or -1.0)
    print(parse_float("abc") or -1.0, parse_float("") or -1.0, parse_float(".") or -1.0, parse_float("1e") or -1.0, parse_float("1.2.3") or -1.0)
    print(parse_float("1e400") or -1.0, parse_float("1e-400") or -1.0, parse_float("0.1") or -1.0, parse_float("123456789012345678901234567890") or -1.0)
